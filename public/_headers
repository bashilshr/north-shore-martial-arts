# Cloudflare static-asset headers. Astro puts a content hash in every file name under
# /_astro/, so a changed file always gets a new URL and browsers can keep these for a year.
/_astro/*
  Cache-Control: public, max-age=31536000, immutable

# Photos keep their WordPress file names (no hash), so cache for a day only.
/images/*
  Cache-Control: public, max-age=86400
