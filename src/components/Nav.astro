---
import { NAV, PHONE, PHONE_HREF, ADDRESS, CLUB_NAME } from '../data/site';

const path = Astro.url.pathname.replace(/\/?$/, '/');
---
<header class="nav">
  <div class="wrap nav__inner">
    <a class="brand" href="/" aria-label={`${CLUB_NAME}, home`}>
      <img src="/logo-mark.png" alt="" width="40" height="42">
      <span class="brand__name"><span>North Shore</span><span>Mixed Martial Arts Club</span></span>
    </a>
    <nav class="nav__links" aria-label="Main">
      {NAV.map((n) => (
        <a class="nav__link" href={n.href} aria-current={path === n.href ? 'page' : undefined}>{n.label}</a>
      ))}
      <a class="btn btn--accent nav__cta" href="/timetable/">Book a free trial</a>
    </nav>
    <button class="theme-toggle" type="button" data-theme-toggle aria-label="Switch to light theme" title="Switch theme">
      <svg class="icon-moon" viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="2" stroke-linecap="round" stroke-linejoin="round" aria-hidden="true"><path d="M21 12.8A9 9 0 1 1 11.2 3a7 7 0 0 0 9.8 9.8z"/></svg>
      <svg class="icon-sun" viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="2" stroke-linecap="round" stroke-linejoin="round" aria-hidden="true"><circle cx="12" cy="12" r="4.5"/><path d="M12 2v2M12 20v2M4.9 4.9l1.4 1.4M17.7 17.7l1.4 1.4M2 12h2M20 12h2M4.9 19.1l1.4-1.4M17.7 6.3l1.4-1.4"/></svg>
    </button>
    <button class="nav__toggle" type="button" aria-expanded="false" aria-controls="menu" data-menu-toggle>Menu</button>
  </div>
</header>

<div class="menu" id="menu" aria-label="Menu">
  <nav class="menu__links" aria-label="Mobile">
    {NAV.map((n, i) => (
      <a class="menu__link" href={n.href} aria-current={path === n.href ? 'page' : undefined}><span>0{i + 1}</span>{n.label}</a>
    ))}
  </nav>
  <div class="menu__foot">
    <button class="menu__theme" type="button" data-theme-toggle>
      <span class="menu__theme-label" data-theme-label>Light theme</span>
    </button>
    <a class="btn btn--accent btn--lg" href="/timetable/">Book a free trial</a>
    <a href={PHONE_HREF}>{PHONE} · {ADDRESS[0]}, Cremorne</a>
  </div>
</div>
