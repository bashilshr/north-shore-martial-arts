---
// Layout for the light "Apple design" concept pages under /concept/.
// Shares the club data, booking sheet and client behaviour with the main site; only the look differs.
import '../styles/concept.css';
import BookingSheet from '../components/BookingSheet.astro';
import { PHONE, PHONE_HREF, ADDRESS, FACEBOOK, CLUB_NAME, KIDS, TEENS, PROGRAMS, DAYS, type RawSession } from '../data/site';
import { BASE, CONCEPT_NAV, conceptHref } from '../data/concept';

interface Props {
  title: string;
  description: string;
  /** Path of the same page on the current site, for the "back to current design" pill. */
  current?: string;
}

const { title, description, current = '/' } = Astro.props;
const path = Astro.url.pathname.replace(/\/?$/, '/');
const mapsHref = `https://maps.google.com/?q=${encodeURIComponent(`${ADDRESS[0]}, ${ADDRESS[1]}`)}`;

// Every timetabled session with its start time in minutes, for the footer's "Next classes" card.
// Times look like '3.40–4.20pm', '9.45–10.15am' or '11.45am–12.25pm': the start takes the end's am/pm if it has none.
function startMinutes(time: string) {
  const [a, b = ''] = time.split('–');
  const suffix = (a.match(/am|pm/) ?? b.match(/am|pm/) ?? ['am'])[0];
  const [h, m = '0'] = a.replace(/am|pm/, '').split('.');
  let hour = Number(h) % 12;
  if (suffix === 'pm') hour += 12;
  return hour * 60 + Number(m);
}
const toNext = (cls: string, raw: RawSession[]) =>
  raw.map(([d, time, note]) => ({ d, start: startMinutes(time), time, note, cls, when: `${DAYS[d]} ${time}${note ? ' · ' + note : ''}` }));
const NEXT_DATA = [...KIDS.flatMap((k) => toNext(k.name, k.sessions)), ...toNext(TEENS.name, TEENS.sessions)]
  .sort((x, y) => x.d - y.d || x.start - y.start);
---
<!doctype html>
<html lang="en-AU" class="concept">
<head>
  <meta charset="utf-8">
  <meta name="viewport" content="width=device-width, initial-scale=1, viewport-fit=cover">
  <title>{title}</title>
  <meta name="description" content={description}>
  <meta name="robots" content="noindex">
  <meta name="theme-color" content="#f5f5f7">
  <link rel="icon" type="image/png" href="/logo-mark.png">
  <script is:inline>document.documentElement.classList.add('js');</script>
</head>
<body>
  <a class="skip-link" href="#main">Skip to content</a>

  <header class="nav" data-material>
    <span class="nav__progress" aria-hidden="true" data-progress></span>
    <div class="wrap nav__inner">
      <a class="brand" href={`${BASE}/`} aria-label={`${CLUB_NAME}, home`}>
        <img src="/logo-mark.png" alt="" width="32" height="34">
        <span class="brand__name"><strong>North Shore</strong><span>Mixed Martial Arts Club</span></span>
      </a>
      <nav class="nav__links" aria-label="Main">
        {CONCEPT_NAV.map((n) => (
          <a class="nav__link" href={n.href} aria-current={path === n.href ? 'page' : undefined}>{n.label}</a>
        ))}
        <a class="pill pill--ink nav__call" href={PHONE_HREF}>Call {PHONE}</a>
      </nav>
      <div class="nav__narrow">
        <button class="pill pill--soft nav__toggle" type="button" aria-expanded="false" aria-controls="menu" data-menu-toggle>Menu</button>
        <div class="pop" id="menu" data-material>
          {CONCEPT_NAV.map((n) => (
            <a class="pop__link" href={n.href} aria-current={path === n.href ? 'page' : undefined}>{n.label}</a>
          ))}
          <a class="pop__call" href={PHONE_HREF}>Call {PHONE}</a>
        </div>
      </div>
    </div>
  </header>

  <main id="main">
    <slot />
  </main>

  <footer class="footer">
    <!-- Closing CTA + the next classes on the timetable (worked out live in Sydney time by concept.ts) -->
    <div class="wrap footer__cta">
      <div class="stack footer__pitch" data-reveal>
        <p class="eyebrow eyebrow--glow">Free trial</p>
        <h2 class="footer__title">Your first class<br>is on us.</h2>
        <p class="footer__lead">Pick any session and we'll hold a spot. Not sure which class fits? Call and we'll help you choose.</p>
        <div class="row">
          <a class="pill pill--accent pill--lg" href={conceptHref('timetable')}>Book a free trial</a>
          <a class="pill pill--glass pill--lg" href={PHONE_HREF}>Call {PHONE}</a>
        </div>
      </div>
      <div class="next" data-reveal style="--d:120ms">
        <p class="next__head"><span class="next__live" aria-hidden="true"></span>Next classes</p>
        <ul class="next__list" data-next data-sessions={JSON.stringify(NEXT_DATA)}>
          {NEXT_DATA.slice(0, 3).map((s) => (
            <li>
              <button class="next__row" type="button" data-book data-cls={s.cls} data-when={s.when}>
                <span class="next__day">{DAYS[s.d].slice(0, 3)}</span>
                <span class="next__info"><strong>{s.cls}</strong><small>{s.time}{s.note ? ` · ${s.note}` : ''}</small></span>
                <span class="next__go" aria-hidden="true">Book</span>
              </button>
            </li>
          ))}
        </ul>
        <a class="next__all" href={conceptHref('timetable')}>Full timetable →</a>
      </div>
    </div>

    <div class="wrap footer__cols">
      <div class="footer__col">
        <p class="footer__label">The club</p>
        <p class="footer__name">{CLUB_NAME}</p>
        <a href={PHONE_HREF}>{PHONE}</a>
        <a href={FACEBOOK} rel="noopener">Facebook</a>
      </div>
      <div class="footer__col">
        <p class="footer__label">Kids</p>
        {KIDS.map((k) => <a href={`${conceptHref('kids-martial-arts')}#${k.key}`}>{k.name} <span>{k.ages}</span></a>)}
      </div>
      <div class="footer__col">
        <p class="footer__label">Adults</p>
        {PROGRAMS.slice(1).map((p) => <a href={conceptHref(p.slug)}>{p.name}</a>)}
      </div>
      <a class="map-card" href={mapsHref} rel="noopener">
        <span class="map-card__pin" aria-hidden="true">
          <svg viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="2" stroke-linecap="round" stroke-linejoin="round"><path d="M12 22s7-6.2 7-12a7 7 0 1 0-14 0c0 5.8 7 12 7 12z"/><circle cx="12" cy="10" r="2.5"/></svg>
        </span>
        <span class="footer__label">Visit</span>
        <strong>{ADDRESS[0]}</strong>
        <span>{ADDRESS[1]}</span>
        <span class="map-card__cta">Open in Maps →</span>
      </a>
    </div>

    <div class="wrap footer__word" aria-hidden="true" data-reveal>
      <span class="emblem emblem--word"></span>
      {'NSMMAC'.split('').map((ch, i) => <span class="footer__letter" style={`--i:${i + 1}`}>{ch}</span>)}
    </div>

    <div class="wrap footer__base">
      <span>© {new Date().getFullYear()} {CLUB_NAME}</span>
      <span class="footer__values">Courage · Respect · Integrity · Loyalty</span>
      <a class="footer__top" href="#main" data-smooth>Back to top ↑</a>
    </div>
  </footer>

  <a class="concept-pill" href={current} data-material>
    <span class="concept-pill__dot" aria-hidden="true"></span>
    Concept preview<span class="concept-pill__sep" aria-hidden="true">·</span><span class="concept-pill__back">Current design →</span>
  </a>

  <BookingSheet />
  <script>
    import '../scripts/site.ts';
    import '../scripts/concept.ts';
  </script>
</body>
</html>
