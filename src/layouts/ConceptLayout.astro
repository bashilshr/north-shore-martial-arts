---
// Layout for the light "Apple design" concept pages under /concept/.
// Shares the club data, booking sheet and client behaviour with the main site; only the look differs.
import '../styles/concept.css';
import BookingSheet from '../components/BookingSheet.astro';
import { PHONE, PHONE_HREF, ADDRESS, FACEBOOK, CLUB_NAME, KIDS, TEENS, PROGRAMS, DAYS, type RawSession } from '../data/site';
import { BASE, CONCEPT_NAV, conceptHref } from '../data/concept';

interface Props {
  title: string;
  description: string;
  /** Path of the same page on the current site, for the "back to current design" pill. */
  current?: string;
}

const { title, description, current = '/' } = Astro.props;
const path = Astro.url.pathname.replace(/\/?$/, '/');
const mapsHref = `https://maps.google.com/?q=${encodeURIComponent(`${ADDRESS[0]}, ${ADDRESS[1]}`)}`;
const fullAddress = `${ADDRESS[0]}, ${ADDRESS[1]}`;
const directionsHref = `https://www.google.com/maps/dir/?api=1&destination=${encodeURIComponent(fullAddress)}`;
const appleMapsHref = `https://maps.apple.com/?q=${encodeURIComponent(CLUB_NAME)}&address=${encodeURIComponent(fullAddress)}`;
// Keyless Google Maps embed; restyled dark in CSS and only loaded when it scrolls near (loading="lazy").
const embedHref = `https://www.google.com/maps?q=${encodeURIComponent(fullAddress)}&z=16&output=embed`;

// Kids age chart in the footer: each program's age range as a bar on a 3–13 scale.
const KID_COLORS: Record<string, string> = { minicubs: '#f0a020', cubs: '#2ec4a6', junior: '#4c8dff', senior: '#ff5a4a' };
const KID_AGES = KIDS.map((k) => {
  const [from, to] = (k.ages.match(/\d+/g) ?? ['3', '13']).map(Number);
  return { key: k.key!, name: k.name, ages: k.ages, from, to, color: KID_COLORS[k.key!] ?? '#e0be00' };
});

// Every timetabled session with its start time in minutes, for the footer's "Next classes" card.
// Times look like '3.40–4.20pm', '9.45–10.15am' or '11.45am–12.25pm': the start takes the end's am/pm if it has none.
function startMinutes(time: string) {
  const [a, b = ''] = time.split('–');
  const suffix = (a.match(/am|pm/) ?? b.match(/am|pm/) ?? ['am'])[0];
  const [h, m = '0'] = a.replace(/am|pm/, '').split('.');
  let hour = Number(h) % 12;
  if (suffix === 'pm') hour += 12;
  return hour * 60 + Number(m);
}
const toNext = (cls: string, raw: RawSession[]) =>
  raw.map(([d, time, note]) => ({ d, start: startMinutes(time), time, note, cls, when: `${DAYS[d]} ${time}${note ? ' · ' + note : ''}` }));
const NEXT_DATA = [...KIDS.flatMap((k) => toNext(k.name, k.sessions)), ...toNext(TEENS.name, TEENS.sessions)]
  .sort((x, y) => x.d - y.d || x.start - y.start);
---
<!doctype html>
<html lang="en-AU" class="concept">
<head>
  <meta charset="utf-8">
  <meta name="viewport" content="width=device-width, initial-scale=1, viewport-fit=cover">
  <title>{title}</title>
  <meta name="description" content={description}>
  <meta name="robots" content="noindex">
  <meta name="theme-color" content="#f5f5f7">
  <link rel="preconnect" href="https://fonts.googleapis.com">
  <link rel="preconnect" href="https://fonts.gstatic.com" crossorigin>
  <link href="https://fonts.googleapis.com/css2?family=Archivo:wdth,wght@62..125,100..900&family=Shippori+Mincho+B1:wght@600;800&family=Atkinson+Hyperlegible+Next:wght@400..700&family=Atkinson+Hyperlegible+Mono:wght@500;600&display=swap" rel="stylesheet">
  <link rel="icon" type="image/png" href="/logo-mark.png">
  <script is:inline>document.documentElement.classList.add('js');</script>
</head>
<body>
  <a class="skip-link" href="#main">Skip to content</a>

  <header class="nav" data-material>
    <span class="nav__progress" aria-hidden="true" data-progress></span>
    <div class="wrap nav__inner">
      <a class="brand" href={`${BASE}/`} aria-label={`${CLUB_NAME}, home`}>
        <img src="/logo-mark.png" alt="" width="32" height="34">
        <span class="brand__name"><strong>North Shore</strong><span>Mixed Martial Arts Club</span></span>
      </a>
      <nav class="nav__links" aria-label="Main">
        {CONCEPT_NAV.map((n) => (
          <a class="nav__link" href={n.href} aria-current={path === n.href ? 'page' : undefined}>{n.label}</a>
        ))}
        <a class="pill pill--ink nav__call" href={PHONE_HREF}>Call {PHONE}</a>
      </nav>
      <div class="nav__narrow">
        <button class="pill pill--soft nav__toggle" type="button" aria-expanded="false" aria-controls="menu" data-menu-toggle>Menu</button>
        <div class="pop" id="menu" data-material>
          {CONCEPT_NAV.map((n) => (
            <a class="pop__link" href={n.href} aria-current={path === n.href ? 'page' : undefined}>{n.label}</a>
          ))}
          <a class="pop__call" href={PHONE_HREF}>Call {PHONE}</a>
        </div>
      </div>
    </div>
  </header>

  <main id="main">
    <slot />
  </main>

  <footer class="footer">
    <!-- Closing CTA + the next classes on the timetable (worked out live in Sydney time by concept.ts) -->
    <div class="wrap footer__cta">
      <div class="stack footer__pitch" data-reveal>
        <p class="eyebrow eyebrow--glow">Free trial</p>
        <h2 class="footer__title">Your first class<br>is <em class="accent">on us.</em></h2>
        <p class="footer__lead">Pick any session and we'll hold a spot. Not sure which class fits? Call and we'll help you choose.</p>
        <div class="row">
          <a class="pill pill--accent pill--lg" href={conceptHref('timetable')}>Book a free trial</a>
          <a class="pill pill--glass pill--lg" href={PHONE_HREF}>Call {PHONE}</a>
        </div>
      </div>
      <div class="next" data-reveal style="--d:120ms">
        <p class="next__head"><span class="next__live" aria-hidden="true"></span>Next classes</p>
        <ul class="next__list" data-next data-sessions={JSON.stringify(NEXT_DATA)}>
          {NEXT_DATA.slice(0, 3).map((s) => (
            <li>
              <button class="next__row" type="button" data-book data-cls={s.cls} data-when={s.when}>
                <span class="next__day">{DAYS[s.d].slice(0, 3)}</span>
                <span class="next__info"><strong>{s.cls}</strong><small>{s.time}{s.note ? ` · ${s.note}` : ''}</small></span>
                <span class="next__go" aria-hidden="true">Book</span>
              </button>
            </li>
          ))}
        </ul>
        <a class="next__all" href={conceptHref('timetable')}>Full timetable →</a>
      </div>
    </div>

    <!-- Bento tiles: club contact, kids age chart, adult programs, and a map banner -->
    <div class="wrap bento" data-reveal>
      <section class="tile tile--club" data-glow aria-label="Contact the club">
        <p class="footer__label">The club</p>
        <p class="footer__name">{CLUB_NAME}</p>
        <a class="tile__phone" href={PHONE_HREF}>
          <span class="tile__ring" aria-hidden="true">
            <svg viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="2" stroke-linecap="round" stroke-linejoin="round"><path d="M22 16.9v3a2 2 0 0 1-2.2 2 19.8 19.8 0 0 1-8.6-3.1 19.5 19.5 0 0 1-6-6A19.8 19.8 0 0 1 2.1 4.2 2 2 0 0 1 4.1 2h3a2 2 0 0 1 2 1.7c.1.9.4 1.8.7 2.7a2 2 0 0 1-.5 2.1L8 9.8a16 16 0 0 0 6 6l1.3-1.3a2 2 0 0 1 2.1-.4c.9.3 1.8.6 2.7.7a2 2 0 0 1 1.7 2z"/></svg>
          </span>
          {PHONE}
        </a>
        <a class="tile__social" href={FACEBOOK} rel="noopener">
          <span aria-hidden="true"><svg viewBox="0 0 24 24" fill="currentColor"><path d="M13.5 21v-7.5h2.5l.4-3h-2.9V8.6c0-.9.3-1.5 1.5-1.5h1.5V4.4c-.3 0-1.2-.1-2.2-.1-2.2 0-3.7 1.3-3.7 3.8v2.3H8v3h2.5V21h3z"/></svg></span>
          Facebook
        </a>
      </section>

      <section class="tile tile--kids" data-glow aria-label="Kids programs by age">
        <p class="footer__label">Kids · ages 3–13</p>
        <ul class="ages">
          {KID_AGES.map((k) => (
            <li>
              <a class="ages__row" href={`${conceptHref('kids-martial-arts')}#${k.key}`} style={`--from:${k.from}; --to:${k.to}; --c:${k.color}`}>
                <span class="ages__name">{k.name}</span>
                <span class="ages__lane" aria-hidden="true"><span class="ages__bar"></span></span>
                <span class="ages__yrs">{k.ages}</span>
              </a>
            </li>
          ))}
        </ul>
        <div class="ages__scale" aria-hidden="true">
          {[3, 5, 7, 9, 11, 13].map((n) => <span style={`--n:${n}`}>{n}</span>)}
        </div>
      </section>

      <nav class="tile tile--adults" data-glow aria-label="Adult programs">
        <p class="footer__label">Adults</p>
        {PROGRAMS.slice(1).map((p) => <a class="tile__link" href={conceptHref(p.slug)}>{p.name}<span aria-hidden="true">→</span></a>)}
      </nav>

      <section class="tile tile--visit" data-glow aria-label="Visit the club">
        <div class="visit__info">
          <p class="footer__label">Visit</p>
          <strong class="visit__street">{ADDRESS[0]}</strong>
          <span class="visit__suburb">{ADDRESS[1]}</span>
          <button class="visit__copy" type="button" data-copy={fullAddress}>
            <svg viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="2" stroke-linecap="round" stroke-linejoin="round" aria-hidden="true"><rect x="9" y="9" width="12" height="12" rx="2.5"/><path d="M5 15H4a2 2 0 0 1-2-2V4a2 2 0 0 1 2-2h9a2 2 0 0 1 2 2v1"/></svg>
            <span data-copy-label>Copy address</span>
          </button>
          <div class="visit__actions">
            <a class="pill pill--accent" href={directionsHref} rel="noopener">Get directions →</a>
            <a class="pill pill--glass" href={appleMapsHref} rel="noopener">Apple Maps</a>
            <a class="pill pill--glass" href={mapsHref} rel="noopener">Google Maps</a>
          </div>
        </div>
        <div class="visit__map" data-map>
          <iframe
            title={`Map showing ${CLUB_NAME}, ${fullAddress}`}
            src={embedHref}
            loading="lazy"
            referrerpolicy="no-referrer-when-downgrade"
            tabindex="-1"
          ></iframe>
          <button class="visit__unlock" type="button" data-map-unlock>
            <span aria-hidden="true">✦</span> Click to explore the map
          </button>
        </div>
      </section>
    </div>

    <div class="wrap footer__word" aria-hidden="true" data-reveal>
      <span class="emblem emblem--word"></span>
      {'NSMMAC'.split('').map((ch, i) => <span class="footer__letter" style={`--i:${i + 1}`}>{ch}</span>)}
    </div>

    <div class="wrap footer__base">
      <span>© {new Date().getFullYear()} {CLUB_NAME}</span>
      <span class="footer__values">Courage · Respect · Integrity · Loyalty</span>
      <a class="footer__top" href="#main" data-smooth>Back to top ↑</a>
    </div>
  </footer>

  <a class="concept-pill" href={current} data-material>
    <span class="concept-pill__dot" aria-hidden="true"></span>
    Concept preview<span class="concept-pill__sep" aria-hidden="true">·</span><span class="concept-pill__back">Current design →</span>
  </a>

  <BookingSheet />
  <script>
    import '../scripts/site.ts';
    import '../scripts/concept.ts';
  </script>
</body>
</html>
