---
import Layout from '../layouts/Layout.astro';
import { PROGRAMS, programHref } from '../data/site';
---
<Layout title="Page not found — North Shore Martial Arts Club" description="This page doesn't exist. Find kids martial arts, kickboxing, boxing and self defence classes in Cremorne.">
  <section class="wrap tt-head rise">
    <p class="eyebrow">404 · Page not found</p>
    <h1 class="display">Missed the<br>target.</h1>
    <p>That page doesn't exist, or it moved when the site was rebuilt. Try one of these instead.</p>
    <div class="btn-row">
      <a class="btn btn--accent" href="/timetable/">Book a free trial</a>
      <a class="btn btn--outline" href="/">Home</a>
    </div>
  </section>
  <section class="wrap other-programs">
    <ul class="plain">
      {PROGRAMS.map((p) => (
        <li><a class="other-link" href={programHref(p)}><span><span class="num">{p.num}</span>{p.name}</span><span aria-hidden="true">→</span></a></li>
      ))}
    </ul>
  </section>
</Layout>
